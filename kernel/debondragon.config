# Merged on top of arm64 defconfig, which already carries the Snapdragon X
# (X1E/X1P) platform drivers that upstream developers test with.

CONFIG_LOCALVERSION="-debondragon"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEBUG_INFO_NONE=y

# Make /boot/vmlinuz a self-decompressing EFI executable, like Debian's own
# arm64 kernels. GRUB 2.12 refuses the default gzip Image ("plain image
# kernel not supported").
CONFIG_EFI_ZBOOT=y

# Ubuntu ships linux-firmware compressed with zstd.  Without this the kernel
# reports the blobs as missing even though their .zst files are installed.
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# Live medium: squashfs root, overlay, ISO9660 on a USB stick
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_LZO=y
CONFIG_OVERLAY_FS=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_NLS_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# Installed system and dual boot with Windows
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=m
CONFIG_NTFS3_FS=m
CONFIG_EXFAT_FS=m
CONFIG_FUSE_FS=m
CONFIG_DM_CRYPT=m
CONFIG_AUTOFS_FS=y

# Boot path: NVMe on pcie6a, USB sticks on the USB-A (multiport) controller.
# The Qualcomm PHYs are modules (PHY_QCOM_QMP=m in defconfig) and are
# loaded from the initramfs, see iso/overlay/etc/initramfs-tools/modules.
CONFIG_PCIE_QCOM=y
CONFIG_BLK_DEV_NVME=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

# BayHub card reader on pcie5
CONFIG_MMC_SDHCI_PCI=m

# Early console on the firmware framebuffer (efifb) until msm takes over.
# Don't enable SYSFB_SIMPLEFB: it would hand the framebuffer to simpledrm,
# which can only be a module here (DRM=m).
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# EC at i2c5 0x76 (fan control, thermal events). Built as a module and
# blacklisted by default by debondragon-support until verified on hardware
# (see docs/hardware-testing.md).
CONFIG_EC_QCOM_HAMOA=m

# USB tethering from phones: Android uses RNDIS, iPhones use ipheth (with
# usbmuxd from userspace). defconfig only has CDC Ethernet/NCM.
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_IPHETH=m

# HDMI debugging (kernel series 3): /dev/drm_dp_auxN reads the HDMI
# converter's DPCD (lane count, link rate, per-lane training status) without
# enabling the output, to find why link training fails.
CONFIG_DRM_DISPLAY_DP_AUX_CHARDEV=y

# Crash diagnostics (kernel series 3). Unplugging HDMI after failed link
# training resets the laptop with nothing in the journal; with these on, a
# CPU or task stuck in the display stack is reported in the log first.
# Report only, never panic or reboot: the *_PANIC options stay 0 / unset.
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=0
CONFIG_HARDLOCKUP_DETECTOR=y
# CONFIG_BOOTPARAM_HARDLOCKUP_PANIC is not set
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=120
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=0
