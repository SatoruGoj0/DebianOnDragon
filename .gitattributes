* text=auto eol=lf
*.ps1 text eol=crlf
*.aml binary
*.bin binary
*.dtb binary
*.iso binary

# Unified-diff context lines begin with a literal space. Do not diagnose that
# format marker, or blank context lines, as whitespace errors in vendored
# kernel adaptation patches.
kernel/patches/*.patch whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
userspace/patches/*.patch whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
