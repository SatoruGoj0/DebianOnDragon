#!/bin/sh
# "DebOnDragon kernels" submenu: one entry per installed DebOnDragon kernel,
# each loading the devicetree that shipped with that kernel. The normal
# Debian entries above all use the newest kernel's devicetree
# (01_debondragon); these entries are for rolling back a kernel *and* its
# devicetree together.
#
# HDMI (DEBONDRAGON_HDMI, default auto): kernels from series 4 on, whose
# devicetree has the HDMI lane mapping verified on hardware, boot with HDMI
# on and get an extra "HDMI off" entry as a fallback; older kernels always
# boot with video=HDMI-A-1:d (their mapping fails link training).
set -e
. /usr/share/grub/grub-mkconfig_lib
[ -r /etc/default/debondragon ] && . /etc/default/debondragon
[ "${DEBONDRAGON_DTB:-none}" = none ] && exit 0

releases=$(ls -1 /boot/dtb/debondragon-*.dtb 2>/dev/null |
	sed -e 's|^/boot/dtb/debondragon-||' -e 's|\.dtb$||' | sort -rV)
[ -n "$releases" ] || exit 0

if [ -n "${GRUB_DEVICE_UUID:-}" ] && [ "${GRUB_DISABLE_LINUX_UUID:-}" != true ]; then
	root="UUID=$GRUB_DEVICE_UUID"
else
	root=$GRUB_DEVICE
fi
boot_device=$(${grub_probe} --target=device /boot)

pin=${DEBONDRAGON_DEFAULT_KERNEL:-}
if [ -n "$pin" ]; then
	if [ -f "/boot/vmlinuz-$pin" ] && [ -f "/boot/initrd.img-$pin" ] &&
	   [ -f "/boot/dtb/debondragon-$pin.dtb" ]; then
		echo "DebOnDragon default kernel: $pin" >&2
	else
		echo "WARNING: DEBONDRAGON_DEFAULT_KERNEL=$pin is not fully installed; GRUB falls back to the first entry" >&2
	fi
fi

hdmi_off=video=HDMI-A-1:d
# The global command line may carry the HDMI switch for the normal entries
# (default/grub.d/debondragon.cfg); decide again here for each kernel.
cmdline=$(echo " $GRUB_CMDLINE_LINUX " | sed "s| $hdmi_off | |g; s|^ *||; s| *$||")

hdmi_dtb_ok() { # release -> true if its devicetree drives HDMI
	case $1 in
	*-debondragon-[0-9]*) [ "${1##*-debondragon-}" -ge 4 ] 2>/dev/null ;;
	*) return 1 ;;
	esac
}

entry() { # title id release extra-args
	kernel=/boot/vmlinuz-$3
	initrd=/boot/initrd.img-$3
	echo "	menuentry '$1' --id $2 {"
	prepare_grub_to_access_device "$boot_device" | sed 's/^/		/'
	echo "		devicetree $(make_system_path_relative_to_its_root "/boot/dtb/debondragon-$3.dtb")"
	echo "		linux $(make_system_path_relative_to_its_root "$kernel") root=$root ro $cmdline${4:+ $4} $GRUB_CMDLINE_LINUX_DEFAULT"
	echo "		initrd $(make_system_path_relative_to_its_root "$initrd")"
	echo "	}"
}

# The ids are stable, for GRUB_DEFAULT and grub-reboot:
#   debondragon-kernels>debondragon-<release>
#   debondragon-kernels>debondragon-<release>-hdmi-off
echo "Adding DebOnDragon kernel entries" >&2
echo "submenu 'DebOnDragon kernels (each with its own devicetree)' --id debondragon-kernels {"
for release in $releases; do
	[ -f "/boot/vmlinuz-$release" ] && [ -f "/boot/initrd.img-$release" ] || continue
	case ${DEBONDRAGON_HDMI:-auto} in
	on) hdmi=on ;;
	off) hdmi=off ;;
	*) if hdmi_dtb_ok "$release"; then hdmi=on; else hdmi=off; fi ;;
	esac
	if [ "$hdmi" = on ]; then
		entry "Debian, Linux $release + its devicetree" "debondragon-$release" "$release" ""
		entry "Debian, Linux $release + its devicetree, HDMI off" "debondragon-$release-hdmi-off" "$release" "$hdmi_off"
	else
		entry "Debian, Linux $release + its devicetree (HDMI off)" "debondragon-$release" "$release" "$hdmi_off"
	fi
done
echo "}"
