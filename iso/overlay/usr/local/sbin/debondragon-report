#!/bin/bash
# Collect what's needed to debug DebOnDragon on real hardware and save it as
# one text file: kernel log, boot args, loaded modules, display/backlight
# state, the PMIC GPIO/PWM configuration the firmware left behind, Wi-Fi link
# state, and the audio DSP and speaker amplifier hints.
#
# Usage: sudo debondragon-report            (saves to a USB stick if one is
#                                            mounted, otherwise to /root)
# No serial numbers are collected (dmesg can contain some device names).
set -uo pipefail

[ "$(id -u)" = 0 ] || exec sudo "$0" "$@"
mountpoint -q /sys/kernel/debug || mount -t debugfs none /sys/kernel/debug 2>/dev/null

section() { printf '\n===== %s =====\n' "$1"; }
run() { section "$*"; "$@" 2>&1; }

report() {
	echo "DebOnDragon report, $(date -u +%Y-%m-%dT%H:%M:%SZ)"
	run uname -a
	run cat /proc/cmdline
	run cat /proc/device-tree/model
	echo
	run lsmod
	section "backlight"
	for b in /sys/class/backlight/*; do
		[ -e "$b" ] || { echo none; continue; }
		echo "$b: brightness=$(cat "$b/brightness") max=$(cat "$b/max_brightness") bl_power=$(cat "$b/bl_power" 2>/dev/null)"
	done
	section "drm connectors"
	for c in /sys/class/drm/card*-*; do
		[ -e "$c" ] && echo "$c: status=$(cat "$c/status") enabled=$(cat "$c/enabled" 2>/dev/null)"
	done
	section "framebuffers"
	cat /proc/fb
	section "regulators (name state)"
	for r in /sys/class/regulator/regulator.*; do
		echo "$(cat "$r/name" 2>/dev/null) $(cat "$r/state" 2>/dev/null)"
	done
	# PMIC GPIO mode/function and PWM channel state show how the firmware
	# drives the backlight.
	section "PMIC pinctrl (SPMI GPIO blocks)"
	for d in /sys/kernel/debug/pinctrl/*spmi*; do
		[ -d "$d" ] || continue
		echo "--- $d"
		cat "$d/pins" 2>/dev/null
	done
	run cat /sys/kernel/debug/pwm
	run cat /sys/kernel/debug/gpio
	section "wifi"
	run iw reg get
	for w in /sys/class/net/*/wireless; do
		[ -e "$w" ] || continue
		dev=$(basename "$(dirname "$w")")
		run iw dev "$dev" info
		run iw dev "$dev" link
		run iw dev "$dev" get power_save
	done
	run lspci -vv -d 17cb:1107
	section "audio"
	for r in /sys/class/remoteproc/remoteproc*; do
		[ -e "$r" ] && echo "$r: $(cat "$r/name") $(cat "$r/state") $(cat "$r/firmware" 2>/dev/null)"
	done
	ls -l /lib/firmware/qcom/x1p42100/LENOVO/83N3/ 2>&1
	run cat /proc/asound/cards
	run ls /sys/bus/soundwire/devices
	# The Windows audio driver packages name the speaker amplifiers
	# (e.g. WSA884x), which the devicetree needs before audio can be enabled.
	section "Windows audio driver packages"
	while read -r dev; do
		m=$(mktemp -d /tmp/debondragon-win.XXXX)
		if mount -o ro -t ntfs3 "$dev" "$m" 2>/dev/null; then
			ls "$m/Windows/System32/DriverStore/FileRepository" 2>/dev/null |
				grep -i -E 'aud|wsa|wcd|spk|speak|amp|acdb|cirrus|cs35|aw88|tas2|max98|sndw|soundwire'
			find "$m/Windows/System32/DriverStore/FileRepository" -iname '*.acdb' -o -iname '*wsa*' 2>/dev/null |
				sed "s|^$m/||" | head -50
			umount "$m"
		fi
		rmdir "$m"
	done < <(lsblk -rpno NAME,FSTYPE | awk '$2 == "ntfs" {print $1}')
	section "dmesg"
	dmesg
}

dest=""
while read -r mnt fstype; do
	case $fstype in vfat|exfat|ntfs|ntfs3|fuseblk)
		case $mnt in /media/*|/mnt/*|/run/media/*) [ -w "$mnt" ] && dest=$mnt && break ;; esac ;;
	esac
done < <(awk '{print $2, $3}' /proc/mounts)
dest=${dest:-/root}

out=$dest/debondragon-report-$(date +%Y%m%d-%H%M%S).txt
report > "$out" 2>&1
sync
echo "Saved: $out"
