# DebOnDragon board settings.
#
# Devicetree that GRUB loads before booting Linux, relative to
# /usr/lib/linux-image-<version>/. Set to "none" to boot without one
# (ACPI only; most hardware will not work).
#
# Internal speakers are off in the default devicetree. To enable them
# (opt-in; Linux has no speaker protection for these amplifiers, keep the
# volume moderate), switch to the -speakers board and apply:
#   DEBONDRAGON_DTB=qcom/x1p42100-lenovo-ideapad-slim3-15q8x10-speakers.dtb
#   sudo debondragon-dtb-sync && sudo update-grub && sudo reboot
DEBONDRAGON_DTB=qcom/x1p42100-lenovo-ideapad-slim3-15q8x10.dtb

# HDMI output: "off" (default) or "on". Off adds video=HDMI-A-1:d to the
# kernel command line, so the HDMI connector always reads "disconnected"
# and is never enabled. On 7.2.0-debondragon-2, link training to the HDMI
# converter fails (black screen), and unplugging the cable or disabling the
# output then resets the laptop. Set "on" only to test an HDMI fix, then:
#   sudo update-grub && sudo reboot
DEBONDRAGON_HDMI=off

# Boot this DebOnDragon kernel by default (with its own devicetree), e.g.
# DEBONDRAGON_DEFAULT_KERNEL=7.2.0-debondragon-2. Empty: the newest kernel,
# as Debian does. Pin a known-good kernel before installing a test kernel,
# then try the new one once with grub-reboot (docs/kernel-upgrade.md).
# Apply with: sudo update-grub
DEBONDRAGON_DEFAULT_KERNEL=

# Brightness. The level is saved once a minute when it changed, and restored
# exactly at boot (so a deliberately low level stays low). Only when no level
# has been saved yet is the boot brightness raised to at least this percent
# of maximum (0 disables it).
DEBONDRAGON_MIN_BRIGHTNESS=30
