# Merged on top of arm64 defconfig, which already carries the Snapdragon X
# (X1E/X1P) platform drivers that upstream developers test with.

CONFIG_LOCALVERSION="-debondragon"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEBUG_INFO_NONE=y

# Live medium: squashfs root, overlay, ISO9660 on a USB stick
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_NLS_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# Installed system and dual boot with Windows
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=m
CONFIG_NTFS3_FS=m
CONFIG_EXFAT_FS=m
CONFIG_FUSE_FS=m
CONFIG_DM_CRYPT=m
CONFIG_AUTOFS_FS=y

# Boot path: NVMe on pcie6a, USB sticks on the USB-A (multiport) controller
CONFIG_PCIE_QCOM=y
CONFIG_PHY_QCOM_QMP_PCIE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

# BayHub card reader on pcie5
CONFIG_MMC_SDHCI_PCI=m

# Early console on the firmware framebuffer until msm takes over
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
