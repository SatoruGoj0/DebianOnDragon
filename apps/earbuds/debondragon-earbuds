    # ---- pairing page
    def _pair_page(self):
        tv = Adw.ToolbarView()
        tv.add_top_bar(Adw.HeaderBar())
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18,
                      margin_top=12, margin_start=16, margin_end=16, margin_bottom=24)
        status = Adw.StatusPage(
            icon_name="bluetooth-active-symbolic", title="Pair earbuds",
            description="Put the earbuds in the case, open the lid and hold the button "
                        "on the case for about 3 seconds until the light flashes.")
        box.append(status)
        self.spinner = Adw.Spinner(halign=Gtk.Align.CENTER, height_request=32)
        box.append(self.spinner)
        self.found = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE)
        box.append(self.found)
        clamp = Adw.Clamp(maximum_size=520, child=box)
        sc = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, child=clamp)
        tv.set_content(sc)
        page = Adw.NavigationPage(child=tv, title="Pair", tag="pair")
        page.connect("hidden", lambda *_: self.bluez.discovery(False))
        return page

    def open_pairing(self):
        if not self.bluez.adapter_powered():
            p = self.bluez.adapter_path()
            if p:
                self.bluez.set_prop(p, "org.bluez.Adapter1", "Powered", GLib.Variant("b", True))
        self.bluez.discovery(True)
        self.nav.push(self.pair_page)
        self.refresh()

    def _fill_found(self, devices):
        child = self.found.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            self.found.remove(child)
            child = nxt
        new = [d for d in devices if not d["paired"]]
        for d in new:
            row = Adw.ActionRow(title=d["name"], subtitle=d["address"], activatable=True)
            row.add_prefix(Gtk.Image(icon_name="audio-headphones-symbolic"))
            btn = Gtk.Button(label="Pair", valign=Gtk.Align.CENTER, css_classes=["suggested-action", "pill"])
            btn.connect("clicked", lambda _b, dd=d: self.pair(dd))
            row.add_suffix(btn)
            self.found.append(row)
        self.found.set_visible(bool(new))

    def pair(self, d):
        self.busy = "Pairing…"
        self.refresh()
        self.bluez.discovery(False)
        self.bluez.agent_start(d["path"])

        def paired(err):
            if err and "AlreadyExists" not in err:
                self.bluez.agent_stop()
                self.busy = None
                self.toast(f"Pairing failed: {err.split(':')[-1].strip()}")
                self.refresh()
                return
            self.bluez.set_prop(d["path"], "org.bluez.Device1", "Trusted", GLib.Variant("b", True))
            self.bluez.call(d["path"], "org.bluez.Device1", "Connect", done=connected)

        def connected(err):
            self.bluez.agent_stop()
            self.busy = None
            self.toast("Connected" if not err else f"Paired, but connecting failed: {err.split(':')[-1].strip()}")
            self.dev = d["path"]
            self.nav.pop_to_tag("main")
            self.refresh()

        self.bluez.call(d["path"], "org.bluez.Device1", "Pair", done=paired, timeout=60000)

    # ---- state
    def toast(self, text):
        self.toasts.add_toast(Adw.Toast(title=text, timeout=3))

    def current(self, devices):
        paired = [d for d in devices if d["paired"]]
        if self.dev:
            for d in paired:
                if d["path"] == self.dev:
                    return d
        return next((d for d in paired if d["connected"]), paired[0] if paired else None)

    def refresh(self):
        try:
            devices = self.bluez.devices()
        except GLib.Error:
            devices = []
        if self.nav.get_visible_page() is self.pair_page:
            self._fill_found(devices)
        d = self.current(devices)
        self.dev = d["path"] if d else None
        self.pulse.address = d["address"] if d and d["connected"] else None

        self._updating = True
        paired = [x for x in devices if x["paired"]]
        self.dev_group.set_visible(len(paired) > 1)
        if len(paired) > 1:
            names = [x["name"] for x in paired]
            if [self.dev_model.get_string(i) for i in range(self.dev_model.get_n_items())] != names:
                self.dev_model.splice(0, self.dev_model.get_n_items(), names)
            self.paired_paths = [x["path"] for x in paired]
            self.dev_row.set_selected(self.paired_paths.index(d["path"]))
        self._updating = False

        connected = bool(d and d["connected"])
        self.ring.update(d["battery"] if d else None, connected)
        self.name_label.set_label(d["name"] if d else "No earbuds yet")
        for c in ("connected", "busy"):
            self.status.remove_css_class(c)
        if self.busy:
            self.status.set_label(self.busy)
            self.status.add_css_class("busy")
        elif not self.bluez.adapter_powered():
            self.status.set_label("Bluetooth is off")
        elif connected:
            self.status.set_label("Connected" + (f" · {d['battery']}%" if d["battery"] is not None else ""))
            self.status.add_css_class("connected")
        elif d:
            self.status.set_label("Not connected")
        else:
            self.status.set_label("Tap + to pair")
        self.connect_btn.set_sensitive(not self.busy)
        if not d:
            self.connect_btn.set_label("Pair earbuds")
            self.connect_btn.remove_css_class("disconnect")
        elif connected:
            self.connect_btn.set_label("Disconnect")
            self.connect_btn.add_css_class("disconnect")
        else:
            self.connect_btn.set_label("Connect")
            self.connect_btn.remove_css_class("disconnect")
        for g in (self.mode_group, self.sound_group, self.mic_group):
            g.set_visible(connected)
        self.anc_group.set_visible(connected)
        self.info_group.set_visible(bool(d))
        # Nothing to control: keep the hero centred instead of top-aligned.
        self.main_box.set_valign(Gtk.Align.START if connected else Gtk.Align.CENTER)
        if d:
            self.addr_row.set_subtitle(d["address"])
        self.apply_pulse()
        return False

    def on_pulse_state(self, state):
        self.state = state
        self.apply_pulse()
        return False

    def apply_pulse(self):
        s = self.state or {}
        self._updating = True
        has_card = bool(s.get("card"))
        call = s.get("profile") in CALL_PROFILES
        self.mode_music.set_active(not call)
        self.mode_call.set_active(call)
        self.mode_music.set_sensitive(bool(s.get("music")))
        self.mode_call.set_sensitive(bool(s.get("call")))
        if not has_card:
            self.mode_hint.set_title("Waiting for the audio connection…")
        elif call:
            self.mode_hint.set_title("Microphone on. Sound is mono and lower quality while in call mode.")
        else:
            self.mode_hint.set_title("Best sound quality. Switch to Calls to use the microphone.")
        codec = s.get("codec")
        self.codec_row.set_subtitle(codec.upper() if codec else "–")
        if s.get("sink"):
            self.vol.set_value(s["sink_volume"])
        self.vol.set_sensitive(bool(s.get("sink")))
        self.out_row.set_sensitive(bool(s.get("sink")))
        self.out_row.set_active(bool(s.get("default_sink")))
        self.mic_group.set_sensitive(bool(s.get("source")))
        if s.get("source"):
            self.micvol.set_value(s["source_volume"])
        self.in_row.set_active(bool(s.get("default_source")))
        if not s.get("source"):
            self.mic_level.set_value(0)
        self._updating = False

    def on_peak(self, peak):
        self.mic_level.set_value(min(1.0, peak * 1.6))
        return False

    # ---- actions
    def on_connect_clicked(self, _btn):
        devices = self.bluez.devices()
        d = self.current(devices)
        if not d:
            self.open_pairing()
            return
        if d["connected"]:
            self.busy = "Disconnecting…"
            self.bluez.call(d["path"], "org.bluez.Device1", "Disconnect", done=self._done)
        else:
            if not self.bluez.adapter_powered():
                self.bluez.set_prop(self.bluez.adapter_path(), "org.bluez.Adapter1",
                                    "Powered", GLib.Variant("b", True))
            self.busy = "Connecting…"
            self.bluez.call(d["path"], "org.bluez.Device1", "Connect", done=self._done)
        self.refresh()

    def _done(self, err):
        self.busy = None
        if err:
            self.toast(err.split(":")[-1].strip() or "Failed")
        self.refresh()

    def on_device_selected(self, row, _p):
        if not self._updating and getattr(self, "paired_paths", None):
            self.dev = self.paired_paths[row.get_selected()]
            self.refresh()

    def on_mode(self, btn):
        if self._updating or not self.state or not self.state.get("card"):
            return
        want = self.state["music"] if btn.get_active() else self.state["call"]
        if want and want != self.state.get("profile"):
            self.pulse.set_profile(self.state["card"], want)

    def on_volume(self, scale):
        if not self._updating and self.state and self.state.get("sink"):
            self.pulse.set_volume("sink", self.state["sink"], scale.get_value())

    def on_mic_volume(self, scale):
        if not self._updating and self.state and self.state.get("source"):
            self.pulse.set_volume("source", self.state["source"], scale.get_value())

    def on_default_out(self, row, _p):
        if not self._updating and row.get_active() and self.state and self.state.get("sink"):
            self.pulse.set_default("sink", self.state["sink"])

    def on_default_in(self, row, _p):
        if not self._updating and row.get_active() and self.state and self.state.get("source"):
            self.pulse.set_default("source", self.state["source"])

    def on_forget(self, _row):
        d = self.current(self.bluez.devices())
        if not d:
            return
        dlg = Adw.AlertDialog(heading=f"Forget {d['name']}?",
                              body="You will need to pair them again to use them with this laptop.")
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("forget", "Forget")
        dlg.set_response_appearance("forget", Adw.ResponseAppearance.DESTRUCTIVE)

        def chosen(_d, resp):
            if resp == "forget":
                self.bluez.call(self.bluez.adapter_path(), "org.bluez.Adapter1", "RemoveDevice",
                                GLib.Variant("(o)", (d["path"],)), done=self._done)
                self.dev = None
        dlg.connect("response", chosen)
        dlg.present(self)


class EarbudsApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.win = None

    def do_startup(self):
        Adw.Application.do_startup(self)
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)
        css = Gtk.CssProvider()
        css.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        quit_action = Gio.SimpleAction.new("quit", None)
        quit_action.connect("activate", lambda *_: self.quit())
        self.add_action(quit_action)
        self.set_accels_for_action("app.quit", ["<Control>q"])
        close = Gio.SimpleAction.new("close", None)
        close.connect("activate", lambda *_: self.win and self.win.close())
        self.add_action(close)
        self.set_accels_for_action("app.close", ["<Control>w", "Escape"])

    def do_activate(self):
        if not self.win:
            self.win = EarbudsWindow(self)
            self.win.connect("close-request", self._closed)
        self.win.present()

    def _closed(self, *_):
        self.win.bluez.discovery(False)
        self.win.bluez.agent_stop()
        self.win = None
        return False


if __name__ == "__main__":
    raise SystemExit(EarbudsApp().run(None))
