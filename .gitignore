/work/
# Scratch build directories used for local kernel iterations (work2, work6,
# and so on). The canonical build still uses /work/.
/work[0-9]*/
/out/
*.iso
*.deb
# Device-signed firmware must never be committed (not redistributable).
*.mbn
*.elf
*.jsn
# Raw hardware boot logs can contain MAC addresses: keep them local.
/boot-logs/
# Local diagnostics from windows/Add-DebianBootEntry.ps1
/windows/boot-entry-report-*.txt

# Python bytecode
__pycache__/
