#!/bin/bash
# Collect what's needed to debug DebOnDragon on real hardware and save it as
# one text file: kernel log, boot args, loaded modules, display/backlight
# state, and the PMIC GPIO/PWM configuration the firmware left behind.
#
# Usage: sudo debondragon-report            (saves to a USB stick if one is
#                                            mounted, otherwise to /root)
# No serial numbers are collected (dmesg can contain some device names).
set -uo pipefail

[ "$(id -u)" = 0 ] || exec sudo "$0" "$@"
mountpoint -q /sys/kernel/debug || mount -t debugfs none /sys/kernel/debug 2>/dev/null

section() { printf '\n===== %s =====\n' "$1"; }
run() { section "$*"; "$@" 2>&1; }

report() {
	echo "DebOnDragon report, $(date -u +%Y-%m-%dT%H:%M:%SZ)"
	run uname -a
	run cat /proc/cmdline
	run cat /proc/device-tree/model
	echo
	run lsmod
	section "backlight"
	for b in /sys/class/backlight/*; do
		[ -e "$b" ] || { echo none; continue; }
		echo "$b: brightness=$(cat "$b/brightness") max=$(cat "$b/max_brightness") bl_power=$(cat "$b/bl_power" 2>/dev/null)"
	done
	section "drm connectors"
	for c in /sys/class/drm/card*-*; do
		[ -e "$c" ] && echo "$c: status=$(cat "$c/status") enabled=$(cat "$c/enabled" 2>/dev/null)"
	done
	section "framebuffers"
	cat /proc/fb
	section "regulators (name state)"
	for r in /sys/class/regulator/regulator.*; do
		echo "$(cat "$r/name" 2>/dev/null) $(cat "$r/state" 2>/dev/null)"
	done
	# PMIC GPIO mode/function and PWM channel state show how the firmware
	# drives the backlight.
	section "PMIC pinctrl (SPMI GPIO blocks)"
	for d in /sys/kernel/debug/pinctrl/*spmi*; do
		[ -d "$d" ] || continue
		echo "--- $d"
		cat "$d/pins" 2>/dev/null
	done
	run cat /sys/kernel/debug/pwm
	run cat /sys/kernel/debug/gpio

	section "DebOnDragon kernels and devicetrees"
	ls -l /boot/vmlinuz-* /boot/dtb/ 2>&1
	dpkg -l 'linux-image-*debondragon*' 'debondragon-support' 2>/dev/null | grep '^ii'
	cat /etc/modprobe.d/debondragon-ec.conf 2>/dev/null

	# Per-feature evidence (docs/hardware-testing.md).
	section "input devices"
	grep -E '^(N|H):' /proc/bus/input/devices
	section "i2c-hid errors (touchpad: 'incomplete report' before the pull-up fix)"
	dmesg | grep -c 'incomplete report'
	dmesg | grep -i 'i2c_hid' | tail -20
	section "USB devices (camera 13d3:54bf on usb_2)"
	lsusb 2>&1
	ls -l /sys/class/video4linux/ 2>&1
	section "HDMI / DP connectors and modes"
	for c in /sys/class/drm/card*-*; do
		[ -e "$c" ] || continue
		echo "$c: status=$(cat "$c/status") modes=$(head -3 "$c/modes" 2>/dev/null | tr '\n' ' ')"
	done
	dmesg | grep -iE 'msm_dp|simple-bridge|hdmi|qmp.*combo|aux_bridge' | tail -20
	section "sound"
	cat /proc/asound/cards 2>&1
	ls /sys/bus/soundwire/devices 2>&1
	section "thermal zones (name temp)"
	for z in /sys/class/thermal/thermal_zone*; do
		echo "$(cat "$z/type") $(cat "$z/temp" 2>/dev/null)"
	done
	section "cooling devices (fan)"
	for c in /sys/class/thermal/cooling_device*; do
		echo "$(cat "$c/type") cur=$(cat "$c/cur_state" 2>/dev/null) max=$(cat "$c/max_state" 2>/dev/null)"
	done
	dmesg | grep -iE 'hamoa|qcom.*-ec|embedded-controller' | tail -10
	section "power supplies"
	for p in /sys/class/power_supply/*; do
		[ -e "$p" ] && echo "$p: $(cat "$p/status" 2>/dev/null) $(cat "$p/capacity" 2>/dev/null)%"
	done
	section "deferred probes"
	cat /sys/kernel/debug/devices_deferred 2>&1

	section "dmesg"
	dmesg
}

dest=""
while read -r mnt fstype; do
	case $fstype in vfat|exfat|ntfs|ntfs3|fuseblk)
		case $mnt in /media/*|/mnt/*|/run/media/*) [ -w "$mnt" ] && dest=$mnt && break ;; esac ;;
	esac
done < <(awk '{print $2, $3}' /proc/mounts)
# No USB stick: save to the invoking user's home rather than /root.
dest=${dest:-$(getent passwd "${SUDO_USER:-root}" | cut -d: -f6)}

out=$dest/debondragon-report-$(date +%Y%m%d-%H%M%S).txt
report > "$out" 2>&1
sync
echo "Saved: $out"
