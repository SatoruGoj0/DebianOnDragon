#!/bin/sh
# Copy the board devicetree of a newly installed kernel to /boot/dtb, where
# /etc/grub.d/01_debondragon picks it up. Runs before zz-update-grub.
set -e
version=$1
[ -r /etc/default/debondragon ] && . /etc/default/debondragon
[ "${DEBONDRAGON_DTB:-none}" = none ] && exit 0

src=/usr/lib/linux-image-$version/$DEBONDRAGON_DTB
if [ ! -f "$src" ]; then
	echo "dtb-debondragon: $src not found, devicetree not updated" >&2
	exit 0
fi
mkdir -p /boot/dtb
cp "$src" "/boot/dtb/debondragon-$version.dtb"
cp "$src" /boot/dtb/debondragon.dtb
