#!/usr/bin/env python3
"""Mute and volume keys for the IdeaPad Slim 3 15Q8X10.

The keyboard is the ITE controller at ACPI QTEC0001 (HID vendor 048D).
Windows shows it as one I2C HID device with several collections. Collection
2 is a standard consumer-control device: mute, volume down, volume up.
Linux hid-input turns those usages into KEY_MUTE, KEY_VOLUMEDOWN and
KEY_VOLUMEUP on their own evdev node.

That node has no letter keys, so X.org's libinput "keyboard" catchall does
not open it, and Hyprland has no binding for those keys. The keys reach
the kernel and then stop. This program reads that node and asks PulseAudio
(or PipeWire's pulse interface) to change the default sink.

A full keyboard, one that also has letter keys, is left alone so this does
not steal typing. DEBONDRAGON_VOLKEYS_SELFTEST=1 checks the mapping and exits.
"""

import array
import errno
import fcntl
import glob
import os
import select
import struct
import subprocess
import sys
import time

KEY_A = 30
KEY_MUTE = 113
KEY_VOLUMEDOWN = 114
KEY_VOLUMEUP = 115
EV_KEY = 0x01
VOL_KEYS = (KEY_MUTE, KEY_VOLUMEDOWN, KEY_VOLUMEUP)

# struct input_event on arm64/amd64: two 64-bit time fields, then type,
# code, value.
EVENT = struct.Struct("llHHi")


def eviocgbit(ev, nbytes):
    # _IOC(_IOC_READ, 'E', 0x20 + ev, nbytes)
    return (2 << 30) | (nbytes << 16) | (ord("E") << 8) | (0x20 + ev)


def key_bits(fd):
    buf = array.array("B", [0] * 96)
    fcntl.ioctl(fd, eviocgbit(EV_KEY, len(buf)), buf)
    found = set()
    for code in range(len(buf) * 8):
        if buf[code // 8] & (1 << (code % 8)):
            found.add(code)
    return found


def wants_device(keys):
    """Consumer-control node: a volume key, and not the typing keyboard."""
    if not any(code in keys for code in VOL_KEYS):
        return False
    if KEY_A in keys:
        return False
    return True


def action_for(code, value):
    """pactl arguments for one event, or None to ignore it.

    value 0 is a release, 1 a press, 2 a repeat. Mute ignores repeats.
    """
    if code == KEY_MUTE and value == 1:
        return ("set-sink-mute", "@DEFAULT_SINK@", "toggle")
    if code == KEY_VOLUMEDOWN and value in (1, 2):
        return ("set-sink-volume", "@DEFAULT_SINK@", "-5%")
    if code == KEY_VOLUMEUP and value in (1, 2):
        return ("set-sink-volume", "@DEFAULT_SINK@", "+5%")
    return None


def selftest():
    assert wants_device({KEY_MUTE, KEY_VOLUMEDOWN, KEY_VOLUMEUP})
    assert not wants_device({KEY_MUTE, KEY_A})
    assert not wants_device({59, 60, 61})
    assert action_for(KEY_MUTE, 1) == ("set-sink-mute", "@DEFAULT_SINK@", "toggle")
    assert action_for(KEY_MUTE, 2) is None
    assert action_for(KEY_MUTE, 0) is None
    assert action_for(KEY_VOLUMEDOWN, 1) == ("set-sink-volume", "@DEFAULT_SINK@", "-5%")
    assert action_for(KEY_VOLUMEUP, 2) == ("set-sink-volume", "@DEFAULT_SINK@", "+5%")
    assert action_for(KEY_VOLUMEUP, 0) is None
    print("ok")


def take_lock():
    run = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    os.makedirs(run, exist_ok=True)
    lock = open(os.path.join(run, "debondragon-volkeys.lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        sys.exit(0)
    return lock


def open_devices():
    fds = []
    for path in sorted(glob.glob("/dev/input/event*")):
        try:
            fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        except OSError:
            continue
        try:
            if wants_device(key_bits(fd)):
                fds.append(fd)
            else:
                os.close(fd)
        except OSError:
            os.close(fd)
    return fds


def apply_action(args):
    subprocess.run(
        ["pactl", *args],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def main():
    # Hold the lock file open for the life of the process. Closing it, or
    # letting it be garbage-collected, drops the lock and a second copy starts.
    lock = take_lock()
    fds = []
    try:
        while True:
            current = open_devices()
            for fd in fds:
                os.close(fd)
            fds = current
            if not fds:
                time.sleep(2)
                continue
            readable, _, _ = select.select(fds, [], [], 2.0)
            for fd in readable:
                while True:
                    try:
                        data = os.read(fd, EVENT.size)
                    except OSError as err:
                        if err.errno in (errno.EAGAIN, errno.EWOULDBLOCK):
                            break
                        raise
                    if len(data) < EVENT.size:
                        break
                    _, _, evtype, code, value = EVENT.unpack(data)
                    if evtype != EV_KEY:
                        continue
                    action = action_for(code, value)
                    if action:
                        apply_action(action)
    finally:
        for fd in fds:
            os.close(fd)
        lock.close()


if __name__ == "__main__":
    if os.environ.get("DEBONDRAGON_VOLKEYS_SELFTEST") == "1":
        selftest()
    else:
        main()
