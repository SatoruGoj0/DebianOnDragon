# ---------------------------------------------------------------- BlueZ ----
class Bluez:
    """Thin wrapper around BlueZ's object manager on the system bus."""

    def __init__(self, on_change):
        self.on_change = on_change
        self.bus = Gio.bus_get_sync(Gio.BusType.SYSTEM)
        self.mgr = Gio.DBusObjectManagerClient.new_for_bus_sync(
            Gio.BusType.SYSTEM, Gio.DBusObjectManagerClientFlags.NONE,
            BLUEZ, "/", None, None, None)
        for sig in ("object-added", "object-removed", "interface-added",
                    "interface-removed", "interface-proxy-properties-changed"):
            self.mgr.connect(sig, lambda *a: self.on_change())
        self.agent_id = None
        self.pairing_target = None

    @staticmethod
    def _prop(iface, name, default=None):
        v = iface.get_cached_property(name) if iface else None
        return v.unpack() if v is not None else default

    def adapter_path(self):
        for obj in self.mgr.get_objects():
            if obj.get_interface("org.bluez.Adapter1"):
                return obj.get_object_path()
        return None

    def adapter_powered(self):
        p = self.adapter_path()
        return bool(p and self._prop(self.mgr.get_interface(p, "org.bluez.Adapter1"), "Powered"))

    def devices(self):
        out = []
        for obj in self.mgr.get_objects():
            dev = obj.get_interface("org.bluez.Device1")
            if not dev:
                continue
            uuids = set(u.lower() for u in self._prop(dev, "UUIDs", []))
            icon = self._prop(dev, "Icon", "") or ""
            # Headphones and headsets only: TVs and speakers advertise A2DP
            # too but report a different icon (video-display, ...).
            if icon:
                if icon not in ("audio-headset", "audio-headphones"):
                    continue
            elif not uuids & AUDIO_UUIDS:
                continue
            bat = obj.get_interface("org.bluez.Battery1")
            out.append({
                "path": obj.get_object_path(),
                "address": self._prop(dev, "Address", ""),
                "name": self._prop(dev, "Alias") or self._prop(dev, "Name") or "Earbuds",
                "paired": bool(self._prop(dev, "Paired", False)),
                "connected": bool(self._prop(dev, "Connected", False)),
                "trusted": bool(self._prop(dev, "Trusted", False)),
                "rssi": self._prop(dev, "RSSI"),
                "battery": self._prop(bat, "Percentage") if bat else None,
            })
        return out

    def call(self, path, iface, method, params=None, done=None, timeout=30000):
        def finish(conn, res):
            err = None
            try:
                conn.call_finish(res)
            except GLib.Error as e:
                err = e.message
            if done:
                done(err)
        self.bus.call(BLUEZ, path, iface, method, params, None,
                      Gio.DBusCallFlags.NONE, timeout, None, finish)

    def set_prop(self, path, iface, name, value, done=None):
        self.call(path, "org.freedesktop.DBus.Properties", "Set",
                  GLib.Variant("(ssv)", (iface, name, value)), done)

    def discovery(self, on):
        p = self.adapter_path()
        if not p:
            return
        if on:
            self.call(p, "org.bluez.Adapter1", "SetDiscoveryFilter",
                      GLib.Variant("(a{sv})", ({"Transport": GLib.Variant("s", "auto")},)))
            self.call(p, "org.bluez.Adapter1", "StartDiscovery")
        else:
            self.call(p, "org.bluez.Adapter1", "StopDiscovery")

    # Pairing agent: only active during a pairing started from this app,
    # and it only accepts requests for the device being paired.
    AGENT_XML = """<node><interface name="org.bluez.Agent1">
      <method name="Release"/>
      <method name="RequestPinCode"><arg type="o" direction="in"/><arg type="s" direction="out"/></method>
      <method name="DisplayPinCode"><arg type="o" direction="in"/><arg type="s" direction="in"/></method>
      <method name="RequestPasskey"><arg type="o" direction="in"/><arg type="u" direction="out"/></method>
      <method name="DisplayPasskey"><arg type="o" direction="in"/><arg type="u" direction="in"/><arg type="q" direction="in"/></method>
      <method name="RequestConfirmation"><arg type="o" direction="in"/><arg type="u" direction="in"/></method>
      <method name="RequestAuthorization"><arg type="o" direction="in"/></method>
      <method name="AuthorizeService"><arg type="o" direction="in"/><arg type="s" direction="in"/></method>
      <method name="Cancel"/>
    </interface></node>"""

    def _agent_call(self, conn, sender, path, iface, method, params, inv):
        dev = params.unpack()[0] if params.n_children() else None
        if method in ("Release", "Cancel", "DisplayPinCode", "DisplayPasskey"):
            inv.return_value(None)
        elif dev != self.pairing_target:
            inv.return_dbus_error("org.bluez.Error.Rejected", "Not the device being paired")
        elif method == "RequestPinCode":
            inv.return_value(GLib.Variant("(s)", ("0000",)))
        elif method == "RequestPasskey":
            inv.return_value(GLib.Variant("(u)", (0,)))
        else:  # RequestConfirmation, RequestAuthorization, AuthorizeService
            inv.return_value(None)

    def agent_start(self, target):
        self.pairing_target = target
        if self.agent_id is None:
            info = Gio.DBusNodeInfo.new_for_xml(self.AGENT_XML).interfaces[0]
            self.agent_id = self.bus.register_object(AGENT_PATH, info, self._agent_call, None, None)
        self.call("/org/bluez", "org.bluez.AgentManager1", "RegisterAgent",
                  GLib.Variant("(os)", (AGENT_PATH, "NoInputNoOutput")))

    def agent_stop(self):
        self.pairing_target = None
        if self.agent_id is not None:
            self.call("/org/bluez", "org.bluez.AgentManager1", "UnregisterAgent",
                      GLib.Variant("(o)", (AGENT_PATH,)))
            self.bus.unregister_object(self.agent_id)
            self.agent_id = None


# ----------------------------------------------------------- PulseAudio ----
class Pulse(threading.Thread):
    """PulseAudio access on a worker thread; results go back via idle_add."""

    def __init__(self, on_state, on_peak):
        super().__init__(daemon=True)
        self.on_state, self.on_peak = on_state, on_peak
        self.jobs = queue.Queue()
        self.address = None
        self.peak_on = False

    def run(self):
        pulse = None
        while True:
            try:
                if pulse is None:
                    pulse = pulsectl.Pulse("debondragon-earbuds")
                try:
                    job = self.jobs.get(timeout=0.12 if self.peak_on else 1.0)
                    job(pulse)
                except queue.Empty:
                    pass
                state = self._state(pulse)
                GLib.idle_add(self.on_state, state)
                if self.peak_on and state and state.get("source"):
                    peak = pulse.get_peak_sample(state["source"], 0.1)
                    GLib.idle_add(self.on_peak, peak)
            except Exception:  # PulseAudio restarted, card vanished, ...
                try:
                    pulse and pulse.close()
                except Exception:
                    pass
                pulse = None
                GLib.idle_add(self.on_state, None)
                threading.Event().wait(1.0)

    def _state(self, pulse):
        if not self.address:
            return None
        mac = self.address.replace(":", "_").upper()
        card = next((c for c in pulse.card_list() if mac in c.name.upper()), None)
        if not card:
            return {"card": None}
        profiles = {p.name: p for p in card.profile_list}
        music = next((n for n in MUSIC_PROFILES if n in profiles), None)
        call = next((n for n in CALL_PROFILES if n in profiles and profiles[n].available), None) \
            or next((n for n in CALL_PROFILES if n in profiles), None)
        sink = next((s for s in pulse.sink_list() if s.card == card.index), None)
        source = next((s for s in pulse.source_list()
                       if s.card == card.index and not s.name.endswith(".monitor")), None)
        info = pulse.server_info()
        return {
            "card": card.name,
            "profile": card.profile_active.name if card.profile_active else "off",
            "music": music, "call": call,
            "sink": sink.name if sink else None,
            "sink_volume": sink.volume.value_flat if sink else 0.0,
            "sink_muted": bool(sink.mute) if sink else False,
            "codec": (sink.proplist.get("bluetooth.codec") if sink else None)
            or (source.proplist.get("bluetooth.codec") if source else None),
            "source": source.name if source else None,
            "source_volume": source.volume.value_flat if source else 0.0,
            "default_sink": info.default_sink_name == (sink.name if sink else None),
            "default_source": info.default_source_name == (source.name if source else None),
        }

    def do(self, fn):
        self.jobs.put(fn)

    def set_profile(self, card, profile):
        self.do(lambda p: p.card_profile_set_by_index(
            p.get_card_by_name(card).index, profile))

    def set_volume(self, kind, name, value):
        def job(p):
            obj = p.get_sink_by_name(name) if kind == "sink" else p.get_source_by_name(name)
            p.volume_set_all_chans(obj, value)
        self.do(job)

    def set_default(self, kind, name):
        def job(p):
            obj = p.get_sink_by_name(name) if kind == "sink" else p.get_source_by_name(name)
            p.default_set(obj)
            # Move playing/recording streams over as well.
            streams = p.sink_input_list() if kind == "sink" else p.source_output_list()
            for s in streams:
                try:
                    (p.sink_input_move if kind == "sink" else p.source_output_move)(s.index, obj.index)
                except pulsectl.PulseOperationFailed:
                    pass
        self.do(job)


# ------------------------------------------------------------ the ring ----
class BatteryRing(Gtk.DrawingArea):
    """Earbuds glyph inside a ring that fills with the battery level."""

    def __init__(self):
        super().__init__()
        self.set_content_width(168)
        self.set_content_height(168)
        self.level = None
        self.connected = False
        self.set_draw_func(self._draw)

    def update(self, level, connected):
        if (level, connected) != (self.level, self.connected):
            self.level, self.connected = level, connected
            self.queue_draw()

    def _draw(self, area, cr, w, h):
        cx, cy, r = w / 2, h / 2, min(w, h) / 2 - 10
        cr.set_line_width(10)
        cr.set_source_rgba(0.34, 0.37, 0.54, 0.35)
        cr.arc(cx, cy, r, 0, 2 * math.pi)
        cr.stroke()
        if self.level is not None and self.connected:
            frac = max(0.0, min(1.0, self.level / 100))
            grad = cairo.LinearGradient(0, 0, w, h)
            if frac <= 0.15:
                grad.add_color_stop_rgb(0, 0.97, 0.46, 0.56)
                grad.add_color_stop_rgb(1, 1.0, 0.62, 0.39)
            else:
                grad.add_color_stop_rgb(0, 0.73, 0.60, 0.97)
                grad.add_color_stop_rgb(1, 0.48, 0.64, 0.97)
            cr.set_source(grad)
            cr.set_line_cap(cairo.LINE_CAP_ROUND)
            cr.arc(cx, cy, r, -math.pi / 2, -math.pi / 2 + frac * 2 * math.pi)
            cr.stroke()
        # glyph: nerd-font earbuds, falls back to a symbolic icon look
        layout = self.create_pango_layout("\U000F184F")
        layout.set_font_description(Pango.FontDescription.from_string("JetBrainsMono Nerd Font 54"))
        tw, th = layout.get_pixel_size()
        if self.connected:
            cr.set_source_rgb(0.75, 0.79, 0.96)
        else:
            cr.set_source_rgb(0.34, 0.37, 0.54)
        cr.move_to(cx - tw / 2, cy - th / 2 - (8 if self.level is not None and self.connected else 0))
        PangoCairo.show_layout(cr, layout)
        if self.level is not None and self.connected:
            lay2 = self.create_pango_layout(f"{self.level}%")
            lay2.set_font_description(Pango.FontDescription.from_string("Sans Bold 13"))
            tw2, th2 = lay2.get_pixel_size()
            cr.set_source_rgb(0.75, 0.79, 0.96)
            cr.move_to(cx - tw2 / 2, cy + th / 2 - 14)
            PangoCairo.show_layout(cr, lay2)


