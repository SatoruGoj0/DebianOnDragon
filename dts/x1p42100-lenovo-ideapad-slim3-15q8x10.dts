// SPDX-License-Identifier: BSD-3-Clause
/*
 * Lenovo IdeaPad Slim 3 15Q8X10 (machine type 83N3)
 * Snapdragon X X1-26-100 (Purwa), 16 GiB, 15.3" 1920x1200 touch LCD.
 *
 * The firmware ACPI tables identify this board as a derivative of the
 * Qualcomm X1 CRD (SUBSYS_CRD08380), and the I2C/PCIe layout in the 83N3
 * DSDT matches the CRD except where noted below. This file therefore
 * starts from x1-crd.dtsi and only overrides what the DSDT shows to be
 * different. Evidence for every override is in docs/board-notes.md.
 */

/dts-v1/;

#include "purwa.dtsi"
#include "x1-crd.dtsi"

/delete-node/ &pmc8380_6;
/delete-node/ &pmc8380_6_thermal;

/ {
	model = "Lenovo IdeaPad Slim 3 15Q8X10";
	compatible = "lenovo,ideapad-slim3-15q8x10", "qcom,x1p42100";
	chassis-type = "laptop";

	aliases {
		serial1 = &uart14;
	};

	/*
	 * The DSDT panel config for this LCD (EDID LEN 0x9197) says, in a
	 * Lenovo change "Modify for LCD Backlight PWM": BacklightType 1 (PMIC
	 * PWM), 14-bit, 2000 Hz. That matches the Lenovo ThinkBook 16 Gen 7
	 * upstream: pm8550 LPG channel 3 at 500000 ns, VBL9 switched by PMC8380
	 * GPIO 10, backlight enable on PMC8380 GPIO 4.
	 */
	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pm8550_pwm 3 500000>;
		enable-gpios = <&pmc8380_3_gpios 4 GPIO_ACTIVE_HIGH>;
		power-supply = <&vreg_edp_bl>;

		pinctrl-0 = <&edp_bl_en>;
		pinctrl-names = "default";
	};

	vreg_edp_bl: regulator-edp-bl {
		compatible = "regulator-fixed";

		regulator-name = "VBL9";
		regulator-min-microvolt = <3600000>;
		regulator-max-microvolt = <3600000>;

		gpio = <&pmc8380_3_gpios 10 GPIO_ACTIVE_HIGH>;
		enable-active-high;

		pinctrl-0 = <&edp_bl_reg_en>;
		pinctrl-names = "default";

		regulator-boot-on;
	};

	/*
	 * WCN7850 power sequencing, as on the other Lenovo Purwa laptop
	 * upstream (ThinkBook 16 Gen 7). DSDT: Wi-Fi at \_SB.PCI4.RP1.WLN,
	 * Bluetooth on UR15 (uart14).
	 */
	vreg_wcn_0p95: regulator-wcn-0p95 {
		compatible = "regulator-fixed";

		regulator-name = "VREG_WCN_0P95";
		regulator-min-microvolt = <950000>;
		regulator-max-microvolt = <950000>;

		vin-supply = <&vreg_wcn_3p3>;
	};

	vreg_wcn_1p9: regulator-wcn-1p9 {
		compatible = "regulator-fixed";

		regulator-name = "VREG_WCN_1P9";
		regulator-min-microvolt = <1900000>;
		regulator-max-microvolt = <1900000>;

		vin-supply = <&vreg_wcn_3p3>;
	};

	vreg_wcn_3p3: regulator-wcn-3p3 {
		compatible = "regulator-fixed";

		regulator-name = "VREG_WCN_3P3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;

		gpio = <&tlmm 214 GPIO_ACTIVE_HIGH>;
		enable-active-high;

		pinctrl-0 = <&wcn_sw_en>;
		pinctrl-names = "default";

		regulator-boot-on;
	};

	wcn7850-pmu {
		compatible = "qcom,wcn7850-pmu";

		vdd-supply = <&vreg_wcn_0p95>;
		vddio-supply = <&vreg_l15b_1p8>;
		vddaon-supply = <&vreg_wcn_0p95>;
		vdddig-supply = <&vreg_wcn_0p95>;
		vddrfa1p2-supply = <&vreg_wcn_1p9>;
		vddrfa1p8-supply = <&vreg_wcn_1p9>;

		wlan-enable-gpios = <&tlmm 117 GPIO_ACTIVE_HIGH>;
		bt-enable-gpios = <&tlmm 116 GPIO_ACTIVE_HIGH>;

		pinctrl-0 = <&wcn_wlan_bt_en>;
		pinctrl-names = "default";

		regulators {
			vreg_pmu_rfa_cmn: ldo0 {
				regulator-name = "vreg_pmu_rfa_cmn";
			};

			vreg_pmu_aon_0p59: ldo1 {
				regulator-name = "vreg_pmu_aon_0p59";
			};

			vreg_pmu_wlcx_0p8: ldo2 {
				regulator-name = "vreg_pmu_wlcx_0p8";
			};

			vreg_pmu_wlmx_0p85: ldo3 {
				regulator-name = "vreg_pmu_wlmx_0p85";
			};

			vreg_pmu_btcmx_0p85: ldo4 {
				regulator-name = "vreg_pmu_btcmx_0p85";
			};

			vreg_pmu_rfa_0p8: ldo5 {
				regulator-name = "vreg_pmu_rfa_0p8";
			};

			vreg_pmu_rfa_1p2: ldo6 {
				regulator-name = "vreg_pmu_rfa_1p2";
			};

			vreg_pmu_rfa_1p8: ldo7 {
				regulator-name = "vreg_pmu_rfa_1p8";
			};

			vreg_pmu_pcie_0p9: ldo8 {
				regulator-name = "vreg_pmu_pcie_0p9";
			};

			vreg_pmu_pcie_1p8: ldo9 {
				regulator-name = "vreg_pmu_pcie_1p8";
			};
		};
	};
};

/*
 * Audio stays off until the 83N3 speaker layout is known. The CRD has four
 * speakers with no speaker protection; driving the wrong amplifier layout
 * can damage speakers.
 */
&{/sound} {
	status = "disabled";
};

&swr0 {
	status = "disabled";
};

&swr3 {
	status = "disabled";
};

/* Device-specific signed firmware, copied from Windows by debondragon-firmware. */
&gpu_zap_shader {
	firmware-name = "qcom/x1p42100/LENOVO/83N3/qcdxkmsucpurwa.mbn";
};

&remoteproc_adsp {
	firmware-name = "qcom/x1p42100/LENOVO/83N3/qcadsp8380.mbn",
			"qcom/x1p42100/LENOVO/83N3/adsp_dtbs.elf";
};

&remoteproc_cdsp {
	firmware-name = "qcom/x1p42100/LENOVO/83N3/qccdsp8380.mbn",
			"qcom/x1p42100/LENOVO/83N3/cdsp_dtbs.elf";
};

/* DSDT: \_SB.I2C1 (0xb80000) has no consumers on the 83N3. */
&i2c0 {
	status = "disabled";
};

/* DSDT: ECKB, QTEC0001 at 0x3a on \_SB.IC10 (0xa84000), GpioInt 0x180. */
&i2c9 {
	clock-frequency = <400000>;

	pinctrl-0 = <&qup_i2c9_data_clk>, <&kybd_default>;
	pinctrl-names = "default";

	status = "okay";

	keyboard@3a {
		compatible = "hid-over-i2c";
		reg = <0x3a>;

		hid-descr-addr = <0x1>;
		interrupts-extended = <&tlmm 67 IRQ_TYPE_LEVEL_LOW>;

		vdd-supply = <&vreg_misc_3p3>;
		vddl-supply = <&vreg_l12b_1p2>;

		wakeup-source;
	};
};

/*
 * DSDT: TCPD on \_SB.IC20 (0x88c000), GpioInt 0x3c0. The DSDT selects one
 * of four touchpad vendors at runtime; this unit has ELAN06FA at 0x15.
 */
&i2c19 {
	clock-frequency = <400000>;

	pinctrl-0 = <&qup_i2c19_data_clk>, <&tpad_default>;
	pinctrl-names = "default";

	status = "okay";

	/* ELAN06FA */
	touchpad@15 {
		compatible = "hid-over-i2c";
		reg = <0x15>;

		hid-descr-addr = <0x1>;
		interrupts-extended = <&tlmm 3 IRQ_TYPE_LEVEL_LOW>;

		vdd-supply = <&vreg_misc_3p3>;
		vddl-supply = <&vreg_l12b_1p2>;

		wakeup-source;
	};

	/* SYNA2BA6 */
	touchpad@2c {
		compatible = "hid-over-i2c";
		reg = <0x2c>;

		hid-descr-addr = <0x20>;
		interrupts-extended = <&tlmm 3 IRQ_TYPE_LEVEL_LOW>;

		vdd-supply = <&vreg_misc_3p3>;
		vddl-supply = <&vreg_l12b_1p2>;

		wakeup-source;
	};

	/* FTCS0038 */
	touchpad@38 {
		compatible = "hid-over-i2c";
		reg = <0x38>;

		hid-descr-addr = <0x1>;
		interrupts-extended = <&tlmm 3 IRQ_TYPE_LEVEL_LOW>;

		vdd-supply = <&vreg_misc_3p3>;
		vddl-supply = <&vreg_l12b_1p2>;

		wakeup-source;
	};

	/* GXTP5100 */
	touchpad@5d {
		compatible = "hid-over-i2c";
		reg = <0x5d>;

		hid-descr-addr = <0x1>;
		interrupts-extended = <&tlmm 3 IRQ_TYPE_LEVEL_LOW>;

		vdd-supply = <&vreg_misc_3p3>;
		vddl-supply = <&vreg_l12b_1p2>;

		wakeup-source;
	};
};

/*
 * DSDT: the touchscreen (ELAN901C) is at 0x10 on \_SB.I2C9 (0xa80000) with
 * GpioInt 0x33, which is what x1-crd.dtsi already describes on i2c8.
 */

/*
 * The panel is an LCD (EDID LEN9197, "LEN153WUXGA"), not the CRD's Samsung
 * OLED. On LCD boards PMC8380 GPIO 4 enables the backlight, so it moves
 * from the panel to the backlight node, as on the other X1 LCD laptops.
 */
&mdss_dp3 {
	aux-bus {
		panel {
			compatible = "edp-panel";
			backlight = <&backlight>;
			/delete-property/ enable-gpios;
			/delete-property/ pinctrl-0;
			/delete-property/ pinctrl-names;
		};
	};
};

/*
 * USB-C DisplayPort outputs stay off for now. Their bridge chain ends at
 * pmic_glink, which needs the ADSP firmware that the live system doesn't
 * have; while those bridges defer, msm never binds, nothing drives the
 * eDP panel and it powers down (seen on hardware: "aux_bridge ... failed
 * to acquire drm_bridge", ADSP firmware load error -2).
 */
&mdss_dp0 {
	status = "disabled";
};

&mdss_dp1 {
	status = "disabled";
};

&mdss_dp2 {
	status = "disabled";
};

&pm8550_pwm {
	status = "okay";
};

&pmc8380_3_gpios {
	edp_bl_reg_en: edp-bl-reg-en-state {
		pins = "gpio10";
		function = "normal";
	};
};

/* DSDT: \_SB.PCI4.RP1.WLN, FastConnect 7800 (17cb:1107). */
&pcie4_port0 {
	wifi@0 {
		compatible = "pci17cb,1107";
		reg = <0x10000 0x0 0x0 0x0 0x0>;

		vddaon-supply = <&vreg_pmu_aon_0p59>;
		vddwlcx-supply = <&vreg_pmu_wlcx_0p8>;
		vddwlmx-supply = <&vreg_pmu_wlmx_0p85>;
		vddrfacmn-supply = <&vreg_pmu_rfa_cmn>;
		vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
		vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
		vddrfa1p8-supply = <&vreg_pmu_rfa_1p8>;
		vddpcie0p9-supply = <&vreg_pmu_pcie_0p9>;
		vddpcie1p8-supply = <&vreg_pmu_pcie_1p8>;
	};
};

/*
 * DSDT: \_SB.PCI5.RP1 carries the BayHub SD card reader (1217:8621), on the
 * slot the CRD uses for WWAN. x1-crd.dtsi already enables pcie5.
 */

&tlmm {
	wcn_sw_en: wcn-sw-en-state {
		pins = "gpio214";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	wcn_wlan_bt_en: wcn-wlan-bt-en-state {
		pins = "gpio116", "gpio117";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};
};

&uart14 {
	status = "okay";

	bluetooth {
		compatible = "qcom,wcn7850-bt";
		max-speed = <3200000>;

		vddaon-supply = <&vreg_pmu_aon_0p59>;
		vddwlcx-supply = <&vreg_pmu_wlcx_0p8>;
		vddwlmx-supply = <&vreg_pmu_wlmx_0p85>;
		vddrfacmn-supply = <&vreg_pmu_rfa_cmn>;
		vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
		vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
		vddrfa1p8-supply = <&vreg_pmu_rfa_1p8>;
	};
};
